import importlib.util
import math
import pathlib
import sys
import types

import pytest


class FakeSurface:
    def __init__(self, size=(0, 0)):
        self.size = size

    def fill(self, color):
        return None

    def blit(self, source, dest):
        return None


class FakeRect:
    def __init__(self, x, y, w, h):
        self.x = x
        self.y = y
        self.w = w
        self.h = h
        self.center = (x + w // 2, y + h // 2)
        self.topright = (x + w, y)


class FakeRenderedText:
    def __init__(self, text):
        self.text = text

    def get_rect(self, center=None, topright=None):
        rect = FakeRect(0, 0, 0, 0)
        if center is not None:
            rect.center = center
        if topright is not None:
            rect.topright = topright
        return rect


class FakeFont:
    def render(self, text, antialias, color):
        return FakeRenderedText(text)


class FakeClock:
    def tick(self, fps):
        return None


class FakeKeyState:
    def __getitem__(self, key):
        return False


class FakePygame(types.SimpleNamespace):
    def __init__(self):
        super().__init__()
        self.QUIT = 256
        self.KEYDOWN = 768
        self.KEYUP = 769
        self.K_ESCAPE = 27
        self.K_r = ord("r")
        self.K_SPACE = 32
        self.K_UP = 273
        self.K_DOWN = 274

        self.Surface = FakeSurface
        self.Rect = FakeRect
        self.init = lambda: None
        self.quit = lambda: None

        self.display = types.SimpleNamespace(
            set_mode=lambda size: FakeSurface(size),
            set_caption=lambda title: None,
            flip=lambda: None,
        )
        self.draw = types.SimpleNamespace(
            polygon=lambda *args, **kwargs: None,
            ellipse=lambda *args, **kwargs: None,
            rect=lambda *args, **kwargs: None,
            line=lambda *args, **kwargs: None,
        )
        self.font = types.SimpleNamespace(SysFont=lambda *args, **kwargs: FakeFont())
        self.time = types.SimpleNamespace(Clock=lambda: FakeClock())
        self.event = types.SimpleNamespace(get=lambda: [])
        self.key = types.SimpleNamespace(get_pressed=lambda: FakeKeyState())


sys.modules.setdefault("pygame", FakePygame())

MODULE_PATH = pathlib.Path("Final_Code.py")
spec = importlib.util.spec_from_file_location("cornhole_game", MODULE_PATH)
game = importlib.util.module_from_spec(spec)
spec.loader.exec_module(game)


@pytest.fixture
def sample_board():
    return game.Board(
        bl=(620, 460),
        br=(860, 460),
        tl=(760, 280),
        tr=(880, 280),
        hole_uv=(0.55, 0.80),
        hole_radius=22,
    )


@pytest.fixture
def sample_bag():
    return game.Bag((120, 450), 10)


@pytest.fixture
def test_game():
    return game.Game()



def test_clamp_limits_values():
    assert game.clamp(50, 10, 80) == 50
    assert game.clamp(5, 10, 80) == 10
    assert game.clamp(100, 10, 80) == 80



def test_distance_squared_returns_expected_value():
    assert game.distance_squared((0, 0), (3, 4)) == 25
    assert game.distance_squared((5, 5), (5, 5)) == 0



def test_board_uv_to_xy_hits_expected_corners(sample_board):
    assert sample_board.uv_to_xy(0, 0) == sample_board.bl
    assert sample_board.uv_to_xy(1, 0) == sample_board.br
    assert sample_board.uv_to_xy(0, 1) == sample_board.tl
    assert sample_board.uv_to_xy(1, 1) == sample_board.tr



def test_board_point_in_board_accepts_center_and_rejects_far_point(sample_board):
    center = sample_board.uv_to_xy(0.5, 0.5)
    assert sample_board.point_in_board(*center) is True
    assert sample_board.point_in_board(100, 100) is False



def test_bag_launch_sets_projectile_velocity(sample_bag):
    sample_bag.launch(45, math.sqrt(2))

    assert sample_bag.in_flight is True
    assert sample_bag.sliding is False
    assert pytest.approx(sample_bag.vel[0], rel=1e-6) == 1.0
    assert pytest.approx(sample_bag.vel[1], rel=1e-6) == -1.0



def test_bag_update_applies_gravity_only(sample_bag):
    sample_bag.launch(0, 10)
    sample_bag.update(gravity=0.35, wind=0.0)

    assert pytest.approx(sample_bag.vel[0], rel=1e-6) == 10.0
    assert pytest.approx(sample_bag.pos[0], rel=1e-6) == 130.0
    assert pytest.approx(sample_bag.pos[1], rel=1e-6) == 450.0
    assert pytest.approx(sample_bag.vel[1], rel=1e-6) == 0.35


def test_bag_update_applies_wind_only(sample_bag):
    sample_bag.launch(0, 10)
    sample_bag.update(gravity=0.0, wind=0.08)

    assert pytest.approx(sample_bag.vel[0], rel=1e-6) == 10.08
    assert pytest.approx(sample_bag.pos[0], rel=1e-6) == 130.08
    assert pytest.approx(sample_bag.pos[1], rel=1e-6) == 450.0
    assert pytest.approx(sample_bag.vel[1], rel=1e-6) == 0.0



def test_bag_start_slide_normalizes_direction(sample_bag):
    sample_bag.start_slide((0, -5), initial_speed=4, max_distance=20)

    assert sample_bag.in_flight is False
    assert sample_bag.sliding is True
    assert sample_bag.slide_dir == (0.0, -1.0)
    assert sample_bag.slide_speed == 4
    assert sample_bag.slide_dist_left == 20



def test_bag_sliding_eventually_stops(sample_bag):
    sample_bag.start_slide((0, -1), initial_speed=1.0, max_distance=2.0)

    for _ in range(20):
        sample_bag.update(gravity=0.35)

    assert sample_bag.sliding is False
    assert sample_bag.in_flight is False
    assert sample_bag.slide_speed == 0.0



def test_change_wind_stays_within_expected_range(test_game):
    for _ in range(200):
        test_game.change_wind()
        assert -0.08 <= test_game.wind <= 0.08



def test_add_points_over_15_resets_score_to_9(test_game):
    test_game.score = 14
    test_game.add_points(2)

    assert test_game.score == 9
    assert test_game.last_result == "WENT OVER 15! RESET TO 9"
    assert test_game.angle == 45
    assert test_game.power == 0
    assert test_game.bag.in_flight is False



def test_add_points_exactly_15_marks_win(test_game):
    test_game.score = 12
    test_game.add_points(3)

    assert test_game.score == 15
    assert test_game.game_won is True
    assert test_game.last_result == "YOU WIN! Press R to play again."



def test_update_scores_hole_shot_and_resets_bag(test_game):
    hole_x, hole_y = test_game.board.hole_center_xy()
    test_game.bag.pos = [hole_x, hole_y]
    test_game.bag.in_flight = True
    test_game.bag.sliding = False
    test_game.score = 0
    test_game.strikes = 2

    test_game.update()

    assert test_game.score == 3
    assert test_game.last_result == "IN THE HOLE! (+3)"
    assert test_game.strikes == 0
    assert test_game.bag.in_flight is False
    assert test_game.bag.pos == test_game.bag.start_pos



def test_update_starts_sliding_when_bag_lands_on_board(test_game):
    landing_point = test_game.board.uv_to_xy(0.5, 0.1)
    test_game.bag.pos = [landing_point[0], test_game.ground_y - test_game.bag.radius]
    test_game.bag.vel = [4.0, 3.0]
    test_game.bag.in_flight = True
    test_game.bag.sliding = False

    test_game.update()

    assert test_game.bag.in_flight is False
    assert test_game.bag.sliding is True
    assert test_game.last_result == "SLIDING..."
    assert test_game.power == 0



def test_update_counts_miss_and_strike_when_landing_off_board(test_game):
    test_game.bag.pos = [100, test_game.ground_y - test_game.bag.radius]
    test_game.bag.vel = [1.0, 2.0]
    test_game.bag.in_flight = True
    test_game.bag.sliding = False
    test_game.strikes = 0

    test_game.update()

    assert test_game.last_result == "MISS. STRIKE 1"
    assert test_game.strikes == 1
    assert test_game.bag.in_flight is False
    assert test_game.bag.pos == test_game.bag.start_pos
